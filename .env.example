# Variables de entorno de Dulce Flor.
#
# Copia este fichero a `.env` para desarrollo local. En producción se ponen en
# Vercel → Settings → Environment Variables, en los tres entornos (Production,
# Preview, Development), y hay que VOLVER A DESPLEGAR: las variables solo se
# aplican a despliegues nuevos.
#
# ⚠️ Este repositorio es PÚBLICO. `.env` está en .gitignore y no debe subirse
# nunca. Aquí solo van nombres y ejemplos, jamás valores reales.

# =====================================================================
#  NAVEGADOR — el prefijo VITE_ las incrusta en el JavaScript que se
#  descarga cualquier visitante. Solo pueden llevarlo datos públicos.
# =====================================================================

# Proyecto de Supabase. La clave es la "anon"/"publishable", NUNCA la
# service_role: esa se salta la seguridad por fila y daría acceso a todos los
# pedidos desde el navegador. La web comprueba esto al arrancar y se desconecta
# de la base de datos antes que publicarla.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Cuentas del panel. Se generan con `node scripts/admin-credentials.cjs`, que
# imprime las contraseñas UNA vez y no escribe nada en disco.
# Formato: usuario:Nombre visible:sal:clave, separadas por ";"
VITE_ADMIN_ACCOUNTS=

# Dominio de los correos con los que el equipo entra al panel (opcional).
# VITE_ADMIN_EMAIL_DOMAIN=dulceflorbcn.es

# Datos del titular para el aviso legal. Van por entorno y no en el código
# porque el repositorio es público.
# VITE_LEGAL_HOLDER=
# VITE_LEGAL_TAX_ID=

# =====================================================================
#  SERVIDOR — solo las leen las funciones de api/. SIN prefijo VITE_,
#  porque no pueden acabar en el navegador bajo ningún concepto.
# =====================================================================

# Las mismas que arriba, pero sin prefijo: la función serverless no tiene
# acceso a las variables del navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Dirección pública del sitio, sin barra final. VIAJA DENTRO DE CADA SMS
# ENVIADO: cambiarla después deja muertos los enlaces ya mandados.
PUBLIC_SITE_URL=https://dulceflorbcn.es

# Proveedor de SMS: labsmobile (por defecto), twilio o pruebas.
# `pruebas` no envía nada y da el envío por bueno: sirve para probar el
# circuito completo sin gastar créditos ni molestar a ningún cliente, y es lo
# que hay que usar mientras la CNMC no apruebe el alias (ver docs/sms.md).
SMS_PROVIDER=pruebas

# Remitente del SMS. "DulceFlor" solo funciona en España una vez inscrito en el
# Registro de Alias de la CNMC, y hay que escribirlo EXACTAMENTE como se
# registró: el bloqueo distingue mayúsculas.
SMS_SENDER=DulceFlor

# Credenciales de LabsMobile. El "token" NO es la contraseña de acceso: se
# genera en el panel WebSMS → Configuración API.
LABSMOBILE_USERNAME=
LABSMOBILE_TOKEN=

# Topes de seguridad (opcionales, con valores por defecto razonables).
# El primero limita cuantos SMS puede recibir un mismo pedido, incluso pidiendo
# reenvio a mano: es la red que impide que una sesion olvidada en la tablet se
# coma el saldo. El segundo limita los paises de destino, porque el telefono lo
# escribe quien rellena el formulario publico y un numero de tarificacion
# especial puede costar varios euros por mensaje.
# SMS_MAX_POR_PEDIDO=5
# SMS_PREFIJOS_PERMITIDOS=+34

# Solo si SMS_PROVIDER=twilio.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------
#  Generador de imagenes con IA
# ---------------------------------------------------------------------

# gemini (por defecto) o pruebas. En modo pruebas no se llama a nadie: se
# devuelve una foto real de referencia, asi que el circuito entero —cupos,
# guardado, etiquetado— se puede recorrer sin gastar ni un centimo.
IA_PROVEEDOR=pruebas

# Clave de Google AI Studio. OJO: tiene que ser una clave con FACTURACION
# ACTIVADA. En el nivel gratuito Google usa lo que se le envia para mejorar sus
# productos y revisores humanos pueden leerlo; en el de pago, no.
GEMINI_API_KEY=

# Modelo. El Lite cuesta unos 3 centimos por imagen y tarda 4 segundos.
# IA_MODELO=gemini-3.1-flash-lite-image

# Sal para convertir la IP del visitante en una clave de contador. NO se guarda
# la IP: se guarda un HMAC con esta sal y la fecha, que cambia cada dia. Genera
# una cadena larga al azar y no la cambies a menudo o se reinician los
# contadores del dia.
AI_IMAGE_IP_SALT=

# TOPE DE GASTO DURO: imagenes que se pueden generar en toda la web en un dia.
# Es la red que hace que un bot o un enlace compartido en un foro no puedan
# costar mas de lo que diga esta cifra. A ~3 centimos la imagen, 40 = 1,20 EUR.
# AI_IMAGE_DAY_LIMIT=40

# El generador escribe contadores que la clave publica no puede tocar, asi que
# esta funcion —y SOLO esta— necesita la service_role. Nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
